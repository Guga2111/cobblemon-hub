{
  "name": "cobbleverse-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "client": "react-router dev",
    "server": "tsx watch server/index.ts",
    "build": "react-router build",
    "typecheck": "tsc --noEmit",
    "extract": "tsx scripts/extract-pokemon.ts && tsx scripts/extract-spawns.ts && tsx scripts/extract-items.ts && tsx scripts/extract-moves.ts && tsx scripts/extract-legendaries.ts && tsx scripts/extract-raids.ts",
    "seed": "tsx scripts/seed-db.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@libsql/client": "^0.17.3",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-router/node": "^7.15.1",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "cookie": "^1.1.1",
    "esbuild": "^0.28.0",
    "hono": "^4.12.23",
    "isbot": "^5",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "tailwind-merge": "^2.6.0",
