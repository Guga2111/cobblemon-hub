# Turso database URL
# For local development: file:./data/cobblemon.db
# For Turso cloud: libsql://<database-name>.turso.io
TURSO_DATABASE_URL=file:./data/cobblemon.db

# Turso auth token (required for cloud, not needed for local file URL)
TURSO_AUTH_TOKEN=

# JWT secret for auth (MUST be >= 32 chars in production)
JWT_SECRET=

# CORS origin for the API server
CORS_ORIGIN=http://localhost:5173

# API URL for the frontend (Vite env var)
VITE_API_URL=http://localhost:3001/api
