# Turso database URL
# For local development: file:./data/cobblemon.db
# For Turso cloud: libsql://<database-name>.turso.io
TURSO_DATABASE_URL=file:./data/cobblemon.db

# Turso auth token (required for cloud, not needed for local file URL)
TURSO_AUTH_TOKEN=

# JWT secret for auth (change in production!)
JWT_SECRET=
